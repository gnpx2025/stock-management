POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_PORT=5432

# Docker Compose published ports (full stack: postgres + api + web)
API_PORT=5080
WEB_PORT=8080

# Browser origins allowed when calling the API directly (nginx same-origin proxy usually does not need these)
CORS_ORIGIN_0=http://localhost:8080
CORS_ORIGIN_1=http://localhost:4200
# CORS_ORIGIN_0=http://192.168.1.10:8080

ASPNETCORE_ENVIRONMENT=Development

# Auth (map to ASP.NET env vars / user-secrets in real deploys)
# Authentication__Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Authentication__Seed__UserName=admin
# Authentication__Seed__Email=admin@example.com
# Authentication__Seed__Password=REPLACE_WITH_LOCAL_SECRET
# Authentication__Refresh__Secure=false
# Authentication__Refresh__SameSite=Lax
